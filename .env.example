# VideoForge settings. Copy to .env (Install.bat does this for you).
# Restart VideoForge after editing. Lines starting with # are ignored.

# ---- AI (makes clips smarter: picks the best moments, writes titles) ----
# Free key from https://console.groq.com/keys  (no local AI install needed)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# Alternative: run a local AI with Ollama (setup_ollama.ps1) — needs ~5 GB disk.
# OLLAMA_MODEL=llama3.2

# ---- Optional ----
# Proxy for video DOWNLOADS only, used automatically if a site is blocked:
# DOWNLOAD_PROXY=socks5://user:pass@host:1080

# Voices (see: .venv\Scripts\edge-tts --list-voices)
# EDGE_TTS_VOICE=en-US-ChristopherNeural
# REACTION_TTS_VOICE=en-US-GuyNeural
